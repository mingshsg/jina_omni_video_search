# Environment template — copy to `.env` and fill in values.
# Never commit `.env`. Secrets stay local (NFR / FR secrets policy).

# --- Elasticsearch Serverless (required for Phase 2+) ---
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
# Set true only if you allow the probe to create a missing EIS embedding endpoint
ALLOW_EIS_ENDPOINT_CREATE=false
ES_INDEX_ASSETS=video-assets
ES_INDEX_CHUNKS=video-chunks
# Drama subtitle segments (multi-lang timed + embed); plan/12
ES_INDEX_DRAMA_SUBTITLES=video-drama-subtitles

# --- Drama enrichment (plan/12; optional until Process as drama is used) ---
# Max probed duration for drama modules (ms). Default 210 minutes.
DRAMA_MAX_DURATION_MS=12600000
# Git submodule path (reference / optional later stages; P1 is Node+ffmpeg).
DRAMA_EPISODE_PROCESSING_ROOT=vendor/episode_processing
# ASR when no sidecar/embedded subs: auto | openai | whisper_cli | off
DRAMA_ASR_PROVIDER=auto
# OpenAI-compatible Whisper (used when auto/openai and key is set)
# DRAMA_ASR_API_KEY=
# DRAMA_ASR_API_URL=https://api.openai.com/v1/audio/transcriptions
# DRAMA_ASR_MODEL=whisper-1
# Or local whisper CLI binary:
# DRAMA_WHISPER_BIN=whisper
# Mac host MLX: run scripts/drama-mlx-whisper-host.py against extracted audio,
# then retry drama subtitles. No ASR key or container Python is required.
# Cap embedded subtitle cues per language
DRAMA_SUBTITLE_EMBED_MAX=400
# Directors script (P2) — EIS multimodal chat_completion
# DRAMA_EIS_CHAT_INFERENCE_ID=.google-gemini-3.5-flash-lite-chat_completion
# Must differ from propose when set:
# DRAMA_EIS_AUDIT_INFERENCE_ID=.anthropic-claude-sonnet-4-5-chat_completion
DRAMA_DIRECTORS_WINDOW_SEC=120
DRAMA_DIRECTORS_MAX_WINDOWS=8
DRAMA_DIRECTORS_FRAMES_PER_WINDOW=4
DRAMA_DIRECTORS_TIMEOUT_MS=180000

# Key actors / scenes (P3) — verified face cards + scene stills
# key_actors requires BOTH propose (above) and a DIFFERENT audit id:
# DRAMA_EIS_AUDIT_INFERENCE_ID=.anthropic-claude-5.1-fable-chat_completion
# Key scenes kept per asset
DRAMA_KEY_SCENES_MAX=6
# Verified key actor cards kept per asset (one per role)
DRAMA_KEY_ACTORS_MAX=6
# Candidate stills scanned for faces
DRAMA_KEY_ACTORS_STILLS=8
# Minimum model-reported frontal score for a face candidate (0-1)
DRAMA_KEY_ACTORS_MIN_FRONTAL=0.7
# Sweep only leaves disposable dirs older than this (ms)
DRAMA_GC_MIN_AGE_MS=3600000

# --- Embedding provider ---
# eis | jina | local
EMBED_PROVIDER=eis
# Required; discover or create — do not assume a fixed id
EMBED_INFERENCE_ID=
EMBED_MODEL=jina-embeddings-v5-omni-small
EMBED_TASK_PASSAGE=retrieval.passage
EMBED_TASK_QUERY=retrieval.query
EMBED_DIMS=1024

# Per-provider binary ceilings (decoded media bytes unless EMBED_BUDGET_BYTE_LAYER says otherwise).
# Set from Phase 2 probe — leave empty until measured.
EIS_MAX_BINARY_BYTES=
JINA_MAX_BINARY_BYTES=
LOCAL_MAX_BINARY_BYTES=
# decoded_media | base64_string | json_request — must match how the probe measured
EMBED_BUDGET_BYTE_LAYER=decoded_media

EMBED_VIDEO_FRAMES=32
EMBED_MAX_LONG_EDGE=1280
EMBED_CONCURRENCY=3

# --- Query parser (Phase 3.5/3.6) ---
# none | dictionary | eis  (default dictionary; eis needs a completion endpoint)
QUERY_PARSER_PROVIDER=dictionary
# EIS completion task id (PUT _inference/completion/<id>, model google-gemini-3.5-flash-lite)
QUERY_PARSER_INFERENCE_ID=
QUERY_PARSER_TIMEOUT_MS=800
QUERY_PARSER_MAX_TOKENS=256
QUERY_PARSER_FACET_MODE=boost
QUERY_PARSER_CACHE_TTL_MS=300000
# Shorter TTL for parses that fell back to the dictionary after an EIS failure.
QUERY_PARSER_DEGRADED_CACHE_TTL_MS=10000
QUERY_PARSER_CACHE_MAX=128
QUERY_PARSER_CONCURRENCY=2

# Only when EMBED_PROVIDER=jina — also reused by Suggest web enrichment
JINA_API_KEY=
# Only when EMBED_PROVIDER=local
LOCAL_EMBED_URL=

# --- Edit-time Suggest enrichment (plan/04) ---
# Product path: Library web → app API → Agent Builder → Jina MCP tools.
# Jina key lives in the Kibana MCP connector — not required in this .env.
# none | agent_builder (demo choice) | jina (optional direct REST / dev only)
SUGGEST_WEB_PROVIDER=agent_builder
SUGGEST_WEB_TIMEOUT_MS=180000
SUGGEST_WEB_MAX_READS=2
# Kibana URL optional on Elastic Cloud (.es. → .kb.). API key falls back to ES key.
# KIBANA_URL=
# KIBANA_API_KEY=
SUGGEST_AGENT_ID=video_metadata_research
# Kibana GenAI connector for Agent Builder converse (speed default: Gemini 3.5 Flash Lite).
# Same EIS catalogue model id as QUERY_PARSER (google-gemini-3.5-flash-lite).
# Empty = use the Kibana project default model (often Claude Sonnet 5).
SUGGEST_AGENT_CONNECTOR_ID=.google-gemini-3.5-flash-lite-chat_completion

# --- Chunking (process default; per-import UI/API can override via chunk_preset) ---
# standard | 60s | 30s | 20s | fine | 2s
CHUNK_PRESET=2s
CHUNK_WINDOW_MS=2000
CHUNK_OVERLAP_MS=1000
CHUNK_MIN_MS=1000

# --- Search / RRF ---
SEARCH_RANK_WINDOW_SIZE=50
SEARCH_RANK_CONSTANT=60
SEARCH_WEIGHT_VIDEO=1.0
SEARCH_WEIGHT_AUDIO=1.0

# --- Media / import ---
MEDIA_ROOT=./data
# Optional sandbox for local-path import; omit or leave empty = "not configured"
LOCAL_IMPORT_ROOT=
MAX_SOURCE_BYTES=2147483648
PLAYBACK_MAX_HEIGHT=720

# --- App ---
# UI + API Accept-Language fallback: en | zh (default English; switch in header)
DEFAULT_LOCALE=en
SCHEMA_VERSION=1

# =============================================================================
# Live video search (Phase 1+) — optional until live mode is used.
# Do not put LIVE_SOURCE_* secrets in the web process env in production Compose.
# Retention product decision (2026-09-10): forever until explicit delete.
# Spool: unset/0 byte caps = unlimited retained growth; soft free-space floor
# LIVE_SPOOL_MIN_FREE_BYTES defaults to 50 GiB (0 disables). Secrets: `.env.worker` only.
# =============================================================================

# --- Live Elasticsearch names (must stay distinct from file indices above) ---
ES_INDEX_LIVE_SOURCES=live-video-sources
ES_INDEX_LIVE_SESSIONS=live-video-sessions
ES_INDEX_LIVE_WORKERS=live-video-workers
# A-20 protect/keep ranges (ops age-delete exclusion); forever default remains.
ES_INDEX_LIVE_PROTECT_RANGES=live-video-protect-ranges
ES_DATA_STREAM_LIVE_CHUNKS=live-video-chunks
ES_DATA_STREAM_LIVE_EVENTS=live-video-events

# --- Source allow policy (MVP: loopback + MediaMTX RTSP ports) ---
# Defaults stay RTSP-only. Phase 10 protocols are opt-in and fail closed.
LIVE_ALLOWED_PROTOCOLS=rtsp
# Include host.docker.internal when live-worker runs in Docker and MediaMTX is
# published on the host (see docker-compose.live.yml). Container 127.0.0.1 ≠ host.
LIVE_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
LIVE_ALLOWED_PORTS=554,8554
LIVE_RTSP_TRANSPORT=tcp
# Phase 10 opt-in examples (uncomment + expand ports only when needed):
# LIVE_ALLOWED_PROTOCOLS=rtsp,hls,srt,whip
# LIVE_ALLOWED_PORTS=554,8554,80,443,8888,8890
# LIVE_SRT_PEER_ALLOWLIST=127.0.0.1

# --- Capture / reconnect ---
# Connect timeout applies until FFmpeg reports media progress, then is cleared.
LIVE_CONNECT_TIMEOUT_MS=10000
# RTSP socket I/O timeout written into the private ffconcat script (ms → µs).
LIVE_READ_TIMEOUT_MS=15000
LIVE_RECONNECT_MAX_MS=10000

# --- Fragment / window (fragment must divide window and step) ---
LIVE_FRAGMENT_MS=2000
LIVE_WINDOW_MS=8000
LIVE_OVERLAP_MS=2000

# --- Queues / processing ---
LIVE_QUEUE_MAX_WINDOWS=12
LIVE_INDEX_ACK_QUEUE_MAX_WINDOWS=12
LIVE_INDEX_MAX_IN_FLIGHT_BATCHES=2
LIVE_PROCESSING_CONCURRENCY=2
LIVE_WINDOW_DEADLINE_MS=15000
LIVE_EMBED_MAX_ATTEMPTS=3
LIVE_EMBED_RETRY_MAX_MS=5000
LIVE_INDEX_MAX_ATTEMPTS=3
LIVE_PROXY_MAX_LONG_EDGE=720
LIVE_PROXY_MAX_ATTEMPTS=3

# --- Spool (optional byte caps: leave empty or 0 = unlimited retained growth) ---
LIVE_SPOOL_DIR=./data/live-spool
LIVE_PENDING_SPOOL_MAX_BYTES=
LIVE_RETAINED_MEDIA_MAX_BYTES=
# Soft free-space floor before pausing capture (bytes). Default 50 GiB; 0 = disabled.
# LIVE_SPOOL_MIN_FREE_BYTES=53687091200
# Refuse manifest append when free disk is below this headroom (bytes).
LIVE_MANIFEST_RESERVE_BYTES=1048576
LIVE_DROP_POLICY=oldest

# --- Retention: forever | indefinite | 0 (no age-based DSL / local purge) ---
LIVE_VECTOR_RETENTION=forever
LIVE_EVENT_RETENTION=forever
LIVE_CLIP_RETENTION=forever

# --- Search / API / worker ---
LIVE_QUERY_CACHE_TTL_MS=300000
LIVE_EVENT_POLL_MS=500
LIVE_SEARCH_MAX_RANGE=24h
LIVE_API_MAX_BODY_BYTES=65536
LIVE_IMAGE_QUERY_MAX_BYTES=5242880
LIVE_MUTATION_RATE_PER_MINUTE=30
LIVE_WORKER_STALE_MS=15000
LIVE_STOP_DRAIN_TIMEOUT_MS=30000
# LIVE_WORKER_ID=   # optional; generated per process when unset
# Optional MediaMTX gateway playback descriptors (placeholders: {sessionId},{sourceId})
# LIVE_PLAYBACK_HLS_URL_TEMPLATE=http://127.0.0.1:8888/{sourceId}/index.m3u8
# LIVE_PLAYBACK_WEBRTC_URL_TEMPLATE=http://127.0.0.1:8889/{sourceId}

# Worker-only LIVE_SOURCE_* secrets: put them in `.env.worker` (see `.env.worker.example`).
# Never add LIVE_SOURCE_* here — Compose web + instrumentation reject them.
