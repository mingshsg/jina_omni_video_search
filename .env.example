# Environment template — copy to `.env` and fill in values.
# Never commit `.env`. Secrets stay local (NFR / FR secrets policy).

# --- Elasticsearch Serverless (required for Phase 2+) ---
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
# Set true only if you allow the probe to create a missing EIS embedding endpoint
ALLOW_EIS_ENDPOINT_CREATE=false
ES_INDEX_ASSETS=video-assets
ES_INDEX_CHUNKS=video-chunks

# --- Embedding provider ---
# eis | jina | local
EMBED_PROVIDER=eis
# Required; discover or create — do not assume a fixed id
EMBED_INFERENCE_ID=
EMBED_MODEL=jina-embeddings-v5-omni-small
EMBED_TASK_PASSAGE=retrieval.passage
EMBED_TASK_QUERY=retrieval.query
EMBED_DIMS=1024

# Per-provider binary ceilings (decoded media bytes unless EMBED_BUDGET_BYTE_LAYER says otherwise).
# Set from Phase 2 probe — leave empty until measured.
EIS_MAX_BINARY_BYTES=
JINA_MAX_BINARY_BYTES=
LOCAL_MAX_BINARY_BYTES=
# decoded_media | base64_string | json_request — must match how the probe measured
EMBED_BUDGET_BYTE_LAYER=decoded_media

EMBED_VIDEO_FRAMES=32
EMBED_MAX_LONG_EDGE=1280
EMBED_CONCURRENCY=3

# Only when EMBED_PROVIDER=jina
JINA_API_KEY=
# Only when EMBED_PROVIDER=local
LOCAL_EMBED_URL=

# --- Chunking (process default; per-import UI/API can override via chunk_preset) ---
# standard | 60s | 30s | 20s | fine
CHUNK_PRESET=standard
CHUNK_WINDOW_MS=64000
CHUNK_OVERLAP_MS=4000
CHUNK_MIN_MS=4000

# --- Search / RRF ---
SEARCH_RANK_WINDOW_SIZE=50
SEARCH_RANK_CONSTANT=60
SEARCH_WEIGHT_VIDEO=1.0
SEARCH_WEIGHT_AUDIO=1.0

# --- Media / import ---
MEDIA_ROOT=./data
# Optional sandbox for local-path import; omit or leave empty = "not configured"
LOCAL_IMPORT_ROOT=
MAX_SOURCE_BYTES=2147483648
PLAYBACK_MAX_HEIGHT=720

# --- App ---
# UI + API Accept-Language fallback: en | zh (default English; switch in header)
DEFAULT_LOCALE=en
SCHEMA_VERSION=1
