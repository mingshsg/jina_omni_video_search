# Worker-only live source secrets — copy to `.env.worker` (never commit).
# Loaded by the live-worker process / Compose service only.
# Do NOT put these keys in `.env` — web startup rejects LIVE_SOURCE_*.
#
# Name pattern: LIVE_SOURCE_<NAME>_URL or LIVE_SOURCE_<NAME>_CONNECTION
# Value: JSON object with url (no userinfo). Optional username/password.

# URLs below are what the *worker process* dials.
# - Host `yarn live-worker`: 127.0.0.1 is fine (MediaMTX port published on host).
# - Docker Compose `live-worker`: use host.docker.internal (127.0.0.1 is the
#   container itself). Also set LIVE_ALLOWED_HOSTS to include host.docker.internal
#   in `.env`, and ensure compose has extra_hosts host.docker.internal:host-gateway.

# Example MediaMTX fixture (docker live-publisher → /fixture):
# LIVE_SOURCE_FIXTURE_URL={"url":"rtsp://host.docker.internal:8554/fixture"}
# Host worker alternative:
# LIVE_SOURCE_FIXTURE_URL={"url":"rtsp://127.0.0.1:8554/fixture"}

# Host webcam via scripts/live-webcam-publish.sh → /webcam (additive path):
# Docker live-worker (recommended for this repo's compose setup):
# LIVE_SOURCE_WEBCAM_URL={"url":"rtsp://host.docker.internal:8554/webcam"}
# Host yarn live-worker:
# LIVE_SOURCE_WEBCAM_URL={"url":"rtsp://127.0.0.1:8554/webcam"}

# LIVE_SOURCE_DEMO_URL={"url":"rtsp://host.docker.internal:8554/live"}

# Phase 10 opt-in examples (require LIVE_ALLOWED_PROTOCOLS + ports):
# LIVE_SOURCE_HLS_URL={"url":"http://host.docker.internal:8888/live/index.m3u8"}
# LIVE_SOURCE_SRT_URL={"url":"srt://host.docker.internal:8890","passphrase":"..."}
# WHIP: browser publishes to MediaMTX WHIP; worker secret is the internal RTSP path:
# LIVE_SOURCE_WHIP_URL={"url":"rtsp://host.docker.internal:8554/whipcam"}
